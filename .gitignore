# ========================================================
# Root GitIgnore for Citeable (Monorepo: Frontend + Backend)
# ========================================================

# --- Environment & Secret Variables ---
.env
.env.*
.env.local
.env.*.local
.env.development
.env.test
.env.production
!.env.example
!.env*.example
!**/.env.example
!.env.template
!**/.env.template

# --- Certificates & Private Keys ---
*.pem
*.key
*.crt
*.pfx
*.p12

# --- OS & System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- IDE & Editor Settings ---
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# --- Logs & Runtime ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.pid
celerybeat.pid

# ========================================================
# Frontend (React / Vite / Tailwind / Node.js)
# ========================================================
node_modules/
*/node_modules/
dist/
dist-ssr/
build/
coverage/
.turbo/
.cache/
.vite/
.eslintcache

# ========================================================
# Backend (FastAPI / Python / SQLAlchemy / Pytest)
# ========================================================
# Byte-compiled / optimized / DLL files
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
*/venv/
.venv/
*/.venv/
env/
*/env/
ENV/
*/ENV/
env.bak/
venv.bak/

# Unit Tests & Coverage (pytest, pytest-asyncio, coverage)
.pytest_cache/
*/.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# Linters, Formatters & Type Checking
.mypy_cache/
*/.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
*/.ruff_cache/

# Databases & Local Storage (SQLite, PostgreSQL, Media/Uploads)
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm
*.db
*.db-wal
*.db-shm
db.sqlite3
db.sqlite3-journal
instance/
media/
uploads/
*/media/
*/uploads/

# Database dumps & exports
*.sql
*.dump

# Docker local data directories & local overrides
pgdata/
*/pgdata/
postgres_data/
*/postgres_data/
docker-compose.override.yml
*/docker-compose.override.yml
docker-compose.*.override.yml

# Jupyter Notebooks
.ipynb_checkpoints
*/.ipynb_checkpoints/
