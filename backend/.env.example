ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-secret-key-at-least-32-chars
# MySQL Database URL format:
# mysql+asyncmy://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=mysql+asyncmy://root:rootpassword@localhost:3306/citeable_db
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=[""]
GOOGLE_CLIENT_ID=
EMAIL_BACKEND=console
RESEND_API_KEY=
EMAIL_FROM=Citeable <no-reply@yourdomain.com>
REQUIRE_VERIFIED_EMAIL=true
